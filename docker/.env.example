# Verathos with Docker (docs/DOCKER.md). Copy this file to .env next to the compose files, set what the role needs,
# then: docker compose up -d

# The role of this directory: compose.miner.yml, compose.validator.yml (light), compose.validator-full.yml (full,
# its references on a reference machine) or compose.reference.yml (a reference machine). The subnet owner's
# validator, the auditor, runs from the installer.
COMPOSE_FILE=compose.miner.yml

# The release's images, tagged with its version only (no latest tag, and nothing updates them by itself). A release
# is a new tag: set it here, then docker compose pull && docker compose up -d. IMAGE_REGISTRY=local runs the images
# docker/build.sh built on this machine.
IMAGE_REGISTRY=ghcr.io/verathos-ai
VERATHOS_VERSION=1.0.0

# Configuration, state (the TLS identity and its pin, measurements, scores) and model weights.
DATA_DIR=./data

# The chain: finney (netuid 96), test (netuid 405), or a wss:// node.
NETWORK=finney
NETUID=

# Miners and validators: the wallet's hotkey and coldkeypub.txt under WALLETS_DIR/WALLET, mounted read-only.
# The coldkey stays elsewhere.
WALLETS_DIR=~/.bittensor/wallets
WALLET=
HOTKEY=default

# The address callers reach this machine at (default: detected) and its TCP port, open for inbound TCP (default:
# the miner 8091, a reference machine 8443; a full validator serves only with PUBLIC_IP set, on 8091).
PUBLIC_IP=
PORT=

# Hugging Face token, for faster downloads of the weights.
HF_TOKEN=

# ---- a miner and a reference machine ----
# on (default): when the catalog pins a Kev engine revision this image does not carry, the container installs it into
# DATA_DIR/engines with the installer's code and serves with it. off: only the image's engines run; a miner serves
# such a model with the image's revision and warns at each start, a reference machine leaves the model out.
ENGINE_AUTO_INSTALL=on
# on (default): when the subnet owner commits a catalog pinning new weights or another engine for a model served here,
# the container sets that model's engines up for it (download, install) and restarts them; the rest runs on, and a
# miner measures again where its rules say so. off: the new pins apply at the next start (docker compose restart).
AUTO_RESTART=on

# ---- a miner ----
# One model for every GPU, or one per GPU in order (kev-4b,clef-flash); default: the one that pays best on each GPU.
MODEL=
# The GPUs to serve on, as nvidia-smi numbers them (0,1); default: all.
GPUS=
# off: the miner's port answers anyone.
FIREWALL=on
# 1: try the machine before registering; it serves and measures, and writes nothing on chain.
NO_PUBLISH=
# 1: this machine serves its GPUs for the hotkey's primary machine; NAME starts its endpoint ids (default: its
# address). On the primary, PEERS lists every worker's ip:port, comma-separated.
WORKER=
NAME=
PEERS=

# ---- a validator ----
# 1: compute the weights without setting them.
DRY_RUN=
# A full validator: the reference machines' files (reference-engines.json), and the public addresses its requests
# to miners leave from (default: detected).
REMOTE_ENGINES_DIR=./reference-engines
EGRESS_IPS=

# ---- a reference machine ----
# The validator machines' addresses, comma-separated; every other address is dropped.
ALLOW=
# off: the float32 references only (the screens are the auditor's).
SCREENS=on
# Where the references run: auto (on GPUs while they fit, else in RAM), cpu or gpu.
DEVICE=auto
# MODEL above: the models to serve (default: the catalog's active models).
